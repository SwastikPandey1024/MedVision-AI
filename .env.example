# MedVision-AI Environment Configuration Example
# Copy this file to .env before running the application locally

# App Settings
ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# API Server Settings
FLASK_APP=src/medvision/api/app.py
FLASK_ENV=development
API_HOST=0.0.0.0
API_PORT=5000

# Streamlit Frontend Settings
STREAMLIT_PORT=8501
MEDVISION_API_URL=http://localhost:5000

# Model & Artifact Settings
MODEL_PATH=artifacts/models/densenet121_finetuned.keras
CLASS_NAMES=NORMAL,PNEUMONIA

# Security & Limits
MAX_CONTENT_LENGTH=16777216  # 16 MB max image upload size
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm
