   "source": [
    "# Cell 3: Phase 1 — RSNA Dataset Ingestion & Quality Control Audit\n",
    "%cd /kaggle/working/MedVision-AI\n",
    "\n",
    "import sys\n",
    "import importlib\n",
    "from pathlib import Path\n",
    "\n",
    "REPO = Path(\"/kaggle/working/MedVision-AI\")\n",
    "SRC = REPO / \"src\"\n",
    "\n",
    "assert Path.cwd().exists(), \"Current working directory is invalid\"\n",
    "assert SRC.exists(), f\"Source directory missing: {SRC}\"\n",
    "assert (SRC / \"medvision\" / \"__init__.py\").exists(), \"medvision __init__.py missing\"\n",
    "\n",
    "if str(SRC) not in sys.path:\n",
    "    sys.path.insert(0, str(SRC))\n",
    "\n",
    "importlib.invalidate_caches()\n",
    "\n",
    "import medvision\n",
    "print(\"MedVision import: OK:\", medvision.__file__)\n",
    "\n",
    "from medvision.data.dataset import find_dataset_root, parse_rsna_manifest\n",
    "from medvision.data.validation import validate_manifest_integrity\n",
    "from medvision.data.splits import create_patient_aware_splits, verify_zero_patient_leakage\n",
    "\n",
    "print(\"=\" * 75)\n",
    "print(\"Phase 1: RSNA Dataset Ingestion & Quality Audit\")\n",
    "print(\"=\" * 75)\n",
    "\n",
    "ds_root = find_dataset_root()\n",
    "labels_file = ds_root / \"stage_2_train_labels.csv\"\n",
    "if not labels_file.exists():\n",
    "    labels_file = ds_root / "stage_1_train_labels.csv"\n",
    "if not labels_file.exists():\n",
    "    matches = list(ds_root.glob(\"*train_labels.csv\"))\n",
    "    if len(matches) > 0:\n",
    "        labels_file = matches[0]\n",
    "\n",
    "if not labels_file.exists():\n",
    "    kaggle_input = Path(\"/kaggle/input\")\n",
    "    attached_items = [str(p) for p in kaggle_input.glob(\"*\")] if kaggle_input.exists() else []\n",
    "    raise FileNotFoundError(\n",
    "        f\"CRITICAL ERROR: Real RSNA Dataset labels file not found at '{ds_root}'.\\n\"\n",
    "        f\"Mounted items under /kaggle/input: {attached_items}\\n\"\n",
    "        \"Synthetic fallback is FORBIDDEN. Please attach 'RSNA Pneumonia Detection Challenge' in Kaggle UI!\"\n",
    "    )\n",
    "\n",
    "print(\"REAL_RSNA_DATASET = YES\")\n",
    "print(f\"Dataset Root Resolved: {ds_root}\")\n",
    "print(f\"Labels File: {labels_file}\")\n",
    "\n",
    "manifest_df = parse_rsna_manifest(ds_root)\n",
    "print(\"[1] Manifest Parsed:\", len(manifest_df), \"unique patient records.\")\n",
    "\n",
    "val_audit = validate_manifest_integrity(manifest_df)\n",
    "print(\"[2] Data Quality Audit Valid:\", val_audit['is_valid'])\n",
    "\n",
    "train_df, val_df, test_df = create_patient_aware_splits(manifest_df, train_ratio=0.70, val_ratio=0.15, test_ratio=0.15)\n",
    "leakage_audit = verify_zero_patient_leakage(train_df, val_df, test_df)\n",
    "print(\"[3] Patient Leakage Audit: Zero Leakage =\", leakage_audit['has_zero_leakage'])\n",
    "print(\"=\" * 75)"
   ]
  },
  {
